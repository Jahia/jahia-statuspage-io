    "**/jest-config/glob": "^14.0.3",
    "**/jest-runtime/glob": "^14.0.3",
    "**/test-exclude/glob": "^14.0.3",
    "**/test-exclude/minimatch": "^11.0.1",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
